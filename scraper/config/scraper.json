{
  "userAgent": "job_seeker_ro_spider",
  "requestTimeoutMs": 10000,
  "pageDelayMs": 1000,
  "staleJobDeletion": false,
  "manageCompany": true,
  "defaultLocation": ["Bucuresti"],
  "defaultWorkmode": "on-site",
  "ownJobUrlPrefix": "https://hochland.ro/cariere/",
  "sources": {
    "sitemap": "https://hochland.ro/sitemap_index.xml",
    "listing": "https://hochland.ro/cariere/",
    "jobArchive": "https://hochland.ro/cariere/"
  },
  "selectors": {
    "jobArticle": [".joburi_locatie_list .job_item", "[class*='job']", ".vacancy, .position, .listing-item"],
    "jobTitle": ["h4", "h1, h2, h3, h4", "[itemprop='title'], [aria-label]", "a"],
    "jobMeta": ["", "p, .meta, [class*='deadline']"]
  }
}
